# Rokovnik: postavke. Kopiraj u .env.local za lokalni rad; u produkciji ih unesi kao varijable okruženja.
# Lokalno NIŠTA od ovoga nije obavezno: bez DATABASE_URL koristi se ugrađena baza u mapi .data/,
# bez ANTHROPIC_API_KEY mailovi se čitaju jednostavnim pravilima, a lozinka administratora je "rokovnik".

# ── Obavezno u produkciji ────────────────────────────────────────────────────
# Postgres (npr. Supabase → Connect → Transaction pooler, port 6543)
DATABASE_URL=
# Tajna za potpisivanje kolačića i poveznica (najmanje 16 znakova; npr. `openssl rand -hex 32`)
APP_SECRET=
# Lozinka za /admin
ADMIN_PASSWORD=
# Javna adresa aplikacije, bez kose crte na kraju (na Netlifyju se čita sama iz URL)
APP_URL=

# ── Čitanje mailova (AI) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model za izvlačenje događaja i rokova
LLM_MODEL=claude-haiku-5-5

# ── Primanje i slanje maila (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
# Signing secret webhooka za događaj email.received (počinje s whsec_)
RESEND_WEBHOOK_SECRET=
# Adresa na koju organizacije šalju mailove; prikazuje se na stranici "Objavi"
INBOUND_ADDRESS=
# Pošiljatelj obavijesti administratoru. Bez vlastite domene radi zadana adresa,
# ali samo prema e-mail adresi vlasnika Resend računa.
RESEND_FROM="Rokovnik <onboarding@resend.dev>"

# ── Administrator ────────────────────────────────────────────────────────────
# Kamo stižu zahtjevi za nove zajednice. Ova adresa je ujedno povjerljivi prosljeđivač:
# kad s nje proslijediš tuđi mail, zajednica se određuje prema izvornom pošiljatelju.
ADMIN_EMAIL=
# Dodatni povjerljivi prosljeđivači, odvojeni zarezom
FORWARDER_EMAILS=

# ── Neobavezno ───────────────────────────────────────────────────────────────
# Tajna za općeniti ulaz /api/inbound/generic (skripta `pnpm mail:test`, drugi izvori maila)
INBOUND_SECRET=
# Ime sustava u sučelju
NEXT_PUBLIC_APP_NAME=Rokovnik
